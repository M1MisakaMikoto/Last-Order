{
  "name": "last-order-vscode",
  "displayName": "Last Order",
  "description": "Last Order VSCode client for workers and manager",
  "version": "0.1.80",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:missionControl.workers",
    "onView:missionControl.manager",
    "onCommand:missionControl.start",
    "onCommand:missionControl.stop",
    "onCommand:missionControl.refresh",
    "onCommand:missionControl.openManager",
    "onCommand:missionControl.openWorker",
    "onCommand:missionControl.openWorkerDiff",
    "onCommand:missionControl.editWorkerNotes",
    "onCommand:missionControl.takeOverWorker",
    "onCommand:missionControl.handBackWorker",
    "onCommand:missionControl.openWorkerWorktree",
    "onCommand:missionControl.sendContext",
    "onCommand:missionControl.createCheckpoint",
    "onCommand:missionControl.restoreCheckpoint",
    "onCommand:missionControl.switchScreen",
    "onCommand:missionControl.archiveWorker",
    "onView:missionControl.diff",
    "onCommand:gitDiffViewer.refresh",
    "onCommand:gitDiffViewer.chooseRepository",
    "onCommand:gitDiffViewer.setupCodex",
    "onCommand:gitDiffViewer.expandChangedDirectories",
    "onCommand:gitDiffViewer.collapseAll",
    "onCommand:gitDiffViewer.chooseComparison",
    "onCommand:gitDiffViewer.compareHead",
    "onCommand:gitDiffViewer.compareWithVersion",
    "onCommand:gitDiffViewer.compareVersions",
    "onCommand:gitDiffViewer.compareIndex",
    "onCommand:gitDiffViewer.openDiff",
    "onCommand:gitDiffViewer.openFile",
    "onCommand:gitDiffViewer.copyPath"
  ],
  "main": "./extension.js",
  "scripts": {
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "package": "npm run prepare:backend && npx --yes @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "missionControl",
          "title": "Last Order",
          "icon": "media/last-order-forest.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "missionControlManager",
          "title": "Last Order",
          "icon": "media/last-order-forest.svg"
        }
      ]
    },
    "views": {
      "missionControl": [
        {
          "id": "missionControl.workers",
          "name": "Workers",
          "contextualTitle": "Last Order"
        },
        {
          "id": "missionControl.diff",
          "name": "Git Diff",
          "contextualTitle": "Last Order Git Diff"
        }
      ],
      "missionControlManager": [
        {
          "id": "missionControl.manager",
          "name": "Manager",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "missionControl.workers",
        "contents": "Last Order is not running for this workspace.\n[Start Last Order](command:missionControl.start)"
      },
      {
        "view": "missionControl.diff",
        "contents": "Open a workspace folder to inspect Git changes.\n[Refresh](command:gitDiffViewer.refresh)"
      }
    ],
    "commands": [
      {
        "command": "missionControl.start",
        "title": "Last Order: Start"
      },
      {
        "command": "missionControl.stop",
        "title": "Last Order: Stop"
      },
      {
        "command": "missionControl.refresh",
        "title": "Last Order: Refresh"
      },
      {
        "command": "missionControl.openManager",
        "title": "Last Order: Open Manager"
      },
      {
        "command": "missionControl.openWorker",
        "title": "Last Order: Open Worker"
      },
      {
        "command": "missionControl.openWorkerDiff",
        "title": "Last Order: Open Worker Diff"
      },
      {
        "command": "missionControl.editWorkerNotes",
        "title": "Last Order: Edit Worker Notes"
      },
      {
        "command": "missionControl.takeOverWorker",
        "title": "Last Order: Take Over Worker"
      },
      {
        "command": "missionControl.handBackWorker",
        "title": "Last Order: Hand Worker Back"
      },
      {
        "command": "missionControl.openWorkerWorktree",
        "title": "Last Order: Open Worker Worktree"
      },
      {
        "command": "missionControl.sendContext",
        "title": "Last Order: Send Editor Context"
      },
      {
        "command": "missionControl.createCheckpoint",
        "title": "Last Order: Create Checkpoint"
      },
      {
        "command": "missionControl.restoreCheckpoint",
        "title": "Last Order: Restore Checkpoint"
      },
      {
        "command": "missionControl.switchScreen",
        "title": "Last Order: Switch Manager/Workers"
      },
      {
        "command": "missionControl.archiveWorker",
        "title": "Last Order: Archive Worker"
      },
      {
        "command": "gitDiffViewer.refresh",
        "title": "Last Order: Refresh Git Diff",
        "category": "Last Order Git Diff",
        "icon": "$(refresh)"
      },
      {
        "command": "gitDiffViewer.chooseRepository",
        "title": "Last Order: Choose Diff Repository",
        "category": "Last Order Git Diff",
        "icon": "$(repo)"
      },
      {
        "command": "gitDiffViewer.setupCodex",
        "title": "Last Order: Configure Diff MCP",
        "category": "Last Order Git Diff",
        "icon": "$(plug)"
      },
      {
        "command": "gitDiffViewer.expandChangedDirectories",
        "title": "Last Order: Expand Changed Directories",
        "category": "Last Order Git Diff",
        "icon": "$(expand-all)"
      },
      {
        "command": "gitDiffViewer.collapseAll",
        "title": "Last Order: Collapse All",
        "category": "Last Order Git Diff",
        "icon": "$(collapse-all)"
      },
      {
        "command": "gitDiffViewer.chooseComparison",
        "title": "Last Order: Choose Diff Comparison",
        "category": "Last Order Git Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitDiffViewer.compareHead",
        "title": "Last Order: Compare Working Tree with HEAD",
        "category": "Last Order Git Diff"
      },
      {
        "command": "gitDiffViewer.compareWithVersion",
        "title": "Last Order: Compare with Version",
        "category": "Last Order Git Diff"
      },
      {
        "command": "gitDiffViewer.compareVersions",
        "title": "Last Order: Compare Two Versions",
        "category": "Last Order Git Diff"
      },
      {
        "command": "gitDiffViewer.compareIndex",
        "title": "Last Order: Compare Index with Working Tree",
        "category": "Last Order Git Diff"
      },
      {
        "command": "gitDiffViewer.openDiff",
        "title": "Last Order: Open Diff",
        "category": "Last Order Git Diff",
        "icon": "$(diff)"
      },
      {
        "command": "gitDiffViewer.openFile",
        "title": "Last Order: Open File",
        "category": "Last Order Git Diff",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitDiffViewer.copyPath",
        "title": "Last Order: Copy Relative Path",
        "category": "Last Order Git Diff"
      }
    ],
    "keybindings": [
      {
        "command": "missionControl.switchScreen",
        "key": "ctrl+tab",
        "when": "missionControl.managerFocus || webviewId == missionControl.manager || webviewId == missionControl.workers || focusedView == missionControl.manager || focusedView == missionControl.workers || activeWebviewPanelId == missionControl.manager"
      },
      {
        "command": "missionControl.switchScreen",
        "key": "ctrl+shift+tab",
        "when": "missionControl.managerFocus || webviewId == missionControl.manager || webviewId == missionControl.workers || focusedView == missionControl.manager || focusedView == missionControl.workers || activeWebviewPanelId == missionControl.manager"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "missionControl.start",
          "when": "view == missionControl.workers",
          "group": "navigation@1"
        },
        {
          "command": "missionControl.openManager",
          "when": "view == missionControl.workers",
          "group": "navigation@2"
        },
        {
          "command": "missionControl.refresh",
          "when": "view == missionControl.workers",
          "group": "navigation@3"
        },
        {
          "command": "missionControl.stop",
          "when": "view == missionControl.workers",
          "group": "navigation@4"
        },
        {
          "command": "missionControl.createCheckpoint",
          "when": "view == missionControl.workers",
          "group": "navigation@5"
        },
        {
          "command": "missionControl.restoreCheckpoint",
          "when": "view == missionControl.workers",
          "group": "navigation@6"
        },
        {
          "command": "gitDiffViewer.setupCodex",
          "when": "view == missionControl.diff && !gitDiffViewer.codexConfigured",
          "group": "navigation@0"
        },
        {
          "command": "gitDiffViewer.chooseRepository",
          "when": "view == missionControl.diff && gitDiffViewer.hasRepository",
          "group": "navigation@1"
        },
        {
          "command": "gitDiffViewer.chooseComparison",
          "when": "view == missionControl.diff",
          "group": "navigation@2"
        },
        {
          "command": "gitDiffViewer.expandChangedDirectories",
          "when": "view == missionControl.diff && gitDiffViewer.allCollapsed && gitDiffViewer.hasChangedDirectories",
          "group": "navigation@9007199254740991"
        },
        {
          "command": "gitDiffViewer.collapseAll",
          "when": "view == missionControl.diff && !gitDiffViewer.allCollapsed",
          "group": "navigation@9007199254740991"
        },
        {
          "command": "gitDiffViewer.refresh",
          "when": "view == missionControl.diff",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "missionControl.openWorkerDiff",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@1"
        },
        {
          "command": "missionControl.openWorkerWorktree",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@2"
        },
        {
          "command": "missionControl.sendContext",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@4"
        },
        {
          "command": "missionControl.editWorkerNotes",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@5"
        },
        {
          "command": "missionControl.takeOverWorker",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@6"
        },
        {
          "command": "missionControl.handBackWorker",
          "when": "viewItem == missionControl.worker",
          "group": "navigation@7"
        },
        {
          "command": "missionControl.archiveWorker",
          "when": "viewItem == missionControl.worker",
          "group": "1_worker@9"
        },
        {
          "command": "gitDiffViewer.openDiff",
          "when": "view == missionControl.diff && viewItem == gitDiffViewer.changedFile",
          "group": "inline@1"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "view == missionControl.diff && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "inline@2"
        },
        {
          "command": "gitDiffViewer.openDiff",
          "when": "view == missionControl.diff && viewItem == gitDiffViewer.changedFile",
          "group": "1_open@1"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "view == missionControl.diff && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "1_open@2"
        },
        {
          "command": "gitDiffViewer.copyPath",
          "when": "view == missionControl.diff && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "2_copy@1"
        },
        {
          "command": "gitDiffViewer.chooseComparison",
          "when": "view == missionControl.diff && viewItem == gitDiffViewer.repository",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitDiffViewer.openDiff",
          "when": "false"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "false"
        },
        {
          "command": "gitDiffViewer.copyPath",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Last Order",
      "properties": {
        "missionControl.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start Last Order when the Last Order view activates."
        },
        "missionControl.autoOpenManager": {
          "type": "boolean",
          "default": true,
          "description": "Focus the Last Order Manager view after activation."
        },
        "missionControl.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable used to start the Last Order backend. Empty uses the extension host Node executable."
        },
        "missionControl.serviceScript": {
          "type": "string",
          "default": "",
          "description": "Absolute path to bin/mission-control.js. Empty resolves the development repository layout."
        },
        "missionControl.keepRunningOnDeactivate": {
          "type": "boolean",
          "default": false,
          "description": "Keep an extension-started Last Order backend running after this VSCode window deactivates."
        },
        "gitDiffViewer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh Last Order Git Diff after file saves or workspace changes."
        },
        "gitDiffViewer.repositorySearchDepth": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum depth when discovering nested Git repositories for Last Order Git Diff."
        }
      }
    }
  }
}
